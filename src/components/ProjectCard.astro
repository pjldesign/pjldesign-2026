---
import { projectUrl, type Project } from '../lib/projects';

interface Props {
  project: Project;
  /** load the thumbnail immediately (above the fold / preloader) */
  eager?: boolean;
  /** compact card for the "Related" row: title only, no tags, no thumbnail zoom */
  related?: boolean;
  /** start hidden (extra "Related" candidates, revealed by the shuffle script) */
  hidden?: boolean;
}
const { project, eager = false, related = false, hidden = false } = Astro.props;
const { title, tags, cover, zoom } = project.data;
const tagLine = tags.join(', ');
const scale = !related && zoom > 100 ? zoom / 100 : 1;
---

<li hidden={hidden}>
  <a href={projectUrl(project)} class="card group block focus-visible:outline-offset-4">
    <div class="relative aspect-[10/7] overflow-hidden bg-neutral-100">
      {
        cover && (
          <img
            src={cover}
            alt={title}
            loading={eager ? 'eager' : 'lazy'}
            decoding="async"
            data-card-img
            class="absolute inset-0 h-full w-full object-cover"
            style={scale > 1 ? `transform: scale(${scale})` : undefined}
          />
        )
      }
      {
        related ? (
          <div class="card-overlay absolute inset-0 hidden text-white lg:block">
            <span class="absolute top-6 left-6 right-6 text-[1.75rem] leading-7">{title}</span>
          </div>
        ) : (
          <div class="card-overlay absolute inset-0 hidden text-white lg:block">
            <span class="absolute top-5 left-6 max-w-[40%] text-[1.35rem] leading-[1.8rem]">{title}</span>
            <span class="absolute top-5 left-[49.45%] max-w-[40%] text-[1.35rem] leading-[1.8rem] font-light">{tagLine}</span>
          </div>
        )
      }
    </div>
    {
      related ? (
        <p class="mt-3 mb-3 text-[1.25rem] leading-6 text-[#555] sm:text-[1.5rem] sm:leading-7 lg:hidden">{title}</p>
      ) : (
        <p class="mt-3 mb-2 grid grid-cols-2 gap-x-4 text-[1.25rem] leading-6 sm:grid-cols-1 sm:gap-y-1 sm:text-[1.375rem] sm:leading-7 lg:hidden">
          <span class="text-pjl">{title}</span>
          {/* phones: tags in pjl orange at 50% so they read as secondary to the full-strength orange title; tablet and up keeps grey */}
          <span class="font-light text-pjl/50 sm:text-[#555] sm:text-[1.125rem] sm:leading-6">{tagLine}</span>
        </p>
      )
    }
  </a>
</li>
