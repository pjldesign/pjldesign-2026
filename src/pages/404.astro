---
import Base from '../layouts/Base.astro';
---

<Base
  page="category"
  title="Page not found | Paul J Lawrence"
  description="That page doesn't exist."
>
  <div class="gutter mx-auto max-w-[1700px] pb-24">
    <h1 class="text-[1.75rem] leading-[1.25] text-pjl sm:text-[2rem] sm:leading-9 lg:text-[6rem] lg:leading-[6.25rem]">
      Page not found
    </h1>
    <p class="mt-4 text-[1.375rem] leading-[1.875rem] font-light text-[#666] sm:text-[1.75rem] sm:leading-9">
      That page doesn’t exist, or it has moved.
      <a href="/" class="text-pjl transition-colors hover:text-ink">Back to the work &rarr;</a>
    </p>
  </div>
</Base>
