---
import Base from '../layouts/Base.astro';
import { site } from '../lib/site';

// The link runs from the underlined words to the end of the phrase (so a trailing "!" hovers and clicks
// with it); only the chosen words carry the underline. Text before them is plain. If the words are empty
// or not found in the phrase, the whole phrase is the link, without an underline.
const at = site.notFoundLinkUnderline ? site.notFoundLink.indexOf(site.notFoundLinkUnderline) : -1;
const before = at < 0 ? '' : site.notFoundLink.slice(0, at);
const under = at < 0 ? site.notFoundLink : site.notFoundLinkUnderline;
const after = at < 0 ? '' : site.notFoundLink.slice(at + under.length);
---

<Base
  page="category"
  title={`${site.notFoundTitle} | Paul J Lawrence`}
  description="That page doesn't exist."
  noindex
>
  {/* All three lines share one size scale (the same as the home intro), in Light. Headline orange, the rest grey.
      Wording comes from content/site.json ("Site settings" in the CMS). */}
  <div class="gutter mx-auto max-w-[1700px] pb-24">
    <h1 class="notfound-copy">{site.notFoundTitle}</h1>
    <p class="notfound-copy">
      {site.notFoundText}{' '}
      {before}<a href="/">{at >= 0 ? <span class="notfound-underline">{under}</span> : under}{after}</a>
    </p>
  </div>
</Base>
